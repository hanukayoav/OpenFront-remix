# Example Nginx location blocks for routing FrontierX authentication & API endpoints
# on Oracle Cloud (Ubuntu ARM) to the local frontierx-auth daemon (127.0.0.1:8787).
#
# Place inside the `server { ... }` block for openfront-2.duckdns.org BEFORE `location /`,
# keeping `/api/create_game`, `/api/adminbot/create_game`, `/api/health`, and `/w<n>/`
# routed to the OpenFront workers / Master process.
#
# SECURITY NOTES:
# - Strips untrusted client-supplied `CF-Connecting-IP` by default so spoofing callers
#   cannot forge rate-limit client IPs. If Cloudflare Authenticated Origin Pulls +
#   `ngx_http_realip_module` (`set_real_ip_from`) are verified on the host, `$remote_addr`
#   already carries the verified Cloudflare client IP safely.
# - Restrict `/api/ready` externally (or keep internal-only) if readiness diagnostics
#   should not be public.
#
# IMPORTANT: Do NOT apply live without operator approval and TLS/Turnstile verification.

# JWKS & Auth lifecycle endpoints
location = /api/.well-known/jwks.json {
    proxy_pass http://127.0.0.1:8787/api/.well-known/jwks.json;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header CF-Connecting-IP "";
}

location = /api/ready {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    proxy_pass http://127.0.0.1:8787/api/ready;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header CF-Connecting-IP "";
}

location ^~ /api/auth/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header CF-Connecting-IP "";
}

